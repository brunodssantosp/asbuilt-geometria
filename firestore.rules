rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Somente usuários autenticados (cadastrados pelo administrador) leem e gravam.
    function logado() { return request.auth != null; }

    match /config/{doc} { allow read, write: if logado(); }
    match /imagens/{id} {
      allow read, write: if logado();
    }
    match /analises/{id} {
      allow read, create, update, delete: if logado();
      match /historico/{h} {
        allow read, create: if logado();
        allow delete: if logado();
        allow update: if false; // histórico não pode ser editado
      }
    }
  }
}
